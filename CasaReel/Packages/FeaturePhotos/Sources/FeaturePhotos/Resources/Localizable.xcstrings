            "value": "Facade"
          }
        }
      }
    },
    "Fachada, sala, cozinha, quartos, banheiros e área externa. Você ainda pode arrastar para ajustar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facade, living room, kitchen, bedrooms, bathrooms and outdoor areas. You can still drag to adjust."
          }
        }
      }
    },
    "Formato não suportado. Use JPEG, HEIC ou PNG.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported format. Use JPEG, HEIC or PNG."
          }
        }
      }
    },
