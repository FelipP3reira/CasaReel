# Generate a random value, keep it outside git, and use the same value in the iOS Debug xcconfig.
CASAREEL_WALK3D_TOKEN=replace-with-a-long-random-token

# Local, non-synchronised folder. Jobs are deleted after WALK3D_RETENTION_HOURS.
WALK3D_DATA_DIR=<caminho-local-do-worker>/jobs
WALK3D_RETENTION_HOURS=24

# Command templates. {dataset}, {output}, and {video} are substituted with absolute paths.
# Keep the commands quoted: they contain spaces and are read by the shell startup command.
BRUSH_TRAIN_COMMAND='<absolute-path>/brush_app {dataset} --total-steps 15000 --max-frames 80 --max-resolution 960 --max-splats 1000000 --export-every 15000 --export-path {output} --export-name scene.ply'
WALK3D_RENDER_COMMAND='<absolute-path>/casareel-walk3d-renderer --dataset {dataset} --input {output}/scene.ply --video {video}'
